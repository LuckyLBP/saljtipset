{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Säljtipset",
  "mainBinaryName": "saljtipset",
  "version": "0.1.0",
  "identifier": "com.saljtipset.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Säljtipset",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Business",
    "shortDescription": "Säljtips från dina säljsamtal",
    "longDescription": "Transkriberar säljsamtal lokalt med KB-Whisper och tar fram säljtips med Claude.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "languages": ["Swedish", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "sv-SE"
      }
    }
  }
}
